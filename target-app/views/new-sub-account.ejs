<html>
<head><title>Core Banking Portal - New Sub-Account</title></head>
<body>
<table border="1" cellpadding="6" cellspacing="0">
  <tr><td colspan="2" bgcolor="#cccccc"><b>Open New Sub-Account for <%= member.name %> (<%= member.id %>)</b></td></tr>
  <% if (error) { %>
    <tr><td colspan="2"><font color="red"><%= error %></font></td></tr>
  <% } %>
  <tr>
    <td colspan="2">
      <form method="POST" action="/members/<%= member.id %>/sub-account/new">
        <table>
          <tr>
            <td>Account Type:</td>
            <td>
              <select name="accountType">
                <option value="">-- select --</option>
                <option value="SAVINGS">Savings</option>
                <option value="CHECKING">Checking</option>
              </select>
            </td>
          </tr>
          <tr>
            <td>Opening Deposit ($):</td>
            <td><input type="text" name="openingDeposit"></td>
          </tr>
          <tr>
            <td colspan="2" align="right">
              <input type="submit" value="Submit">
            </td>
          </tr>
        </table>
      </form>
    </td>
  </tr>
</table>
</body>
</html>

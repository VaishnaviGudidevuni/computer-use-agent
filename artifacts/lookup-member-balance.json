{
  "id": "lookup-member-balance",
  "name": "Look Up Member Balance",
  "version": "1.0.5",
  "description": "Look up a member and return their current balance.",
  "target": {
    "appName": "Legacy Mock Bank",
    "baseUrl": "http://localhost:4000"
  },
  "parameters": [
    {
      "name": "memberId",
      "type": "string",
      "description": "The member ID to look up.",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "description": "The member's name shown on the member detail page."
    },
    {
      "name": "savingsBalance",
      "type": "number",
      "description": "The member's current balance as a number."
    }
  ],
  "steps": [
    {
      "id": "open-member-search",
      "action": "navigate",
      "description": "Open the banking application's member search page.",
      "value": "http://localhost:4000",
      "checkpoint": "Member Search page is visible."
    },
    {
      "id": "enter-member-id",
      "action": "type",
      "description": "Enter the member ID into the member search field.",
      "target": {
        "type": "css",
        "value": "input[name=\"memberId\"]",
        "fallback": [
          {
            "type": "xpath",
            "value": "//input[@name=\"memberId\"]"
          }
        ]
      },
      "value": "{{memberId}}"
    },
    {
      "id": "search-member",
      "action": "click",
      "description": "Click the Search button.",
      "target": {
        "type": "role",
        "value": "button:Search",
        "fallback": [
          {
            "type": "css",
            "value": "input[type=\"submit\"]"
          }
        ]
      },
      "checkpoint": "Member search result is displayed."
    },
    {
      "id": "read-member-name",
      "action": "extract",
      "description": "Read the member's name from the member detail table.",
      "target": {
        "type": "xpath",
        "value": "//tr[td[1][normalize-space()='Name']]/td[2]",
        "fallback": [
          {
            "type": "css",
            "value": "tr:nth-of-type(3) td:nth-of-type(2)"
          }
        ]
      },
      "output": "memberName"
    },
    {
      "id": "read-savings-balance",
      "action": "extract",
      "description": "Read the current balance from the member detail table.",
      "target": {
        "type": "xpath",
        "value": "//tr[td[1][normalize-space()='Current Balance']]/td[2]",
        "fallback": [
          {
            "type": "css",
            "value": "tr:nth-of-type(4) td:nth-of-type(2)"
          }
        ]
      },
      "output": "savingsBalance",
      "checkpoint": "Current balance is available."
    }
  ],
  "successCondition": "The member detail page is displayed and the current balance has been extracted.",
  "createdAt": "2026-09-15T00:00:00.000Z",
  "status": "draft"
}
{
  "id": "lookup-member-balance",
  "name": "Look Up Member Balance",
  "version": "1.0.0",
  "description": "Look up a member and return their current savings balance.",
  "target": {
    "appName": "Legacy Mock Bank",
    "baseUrl": "http://localhost:4000"
  },
  "parameters": [
    {
      "name": "memberId",
      "type": "string",
      "description": "The member ID to look up.",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "description": "The name of the member."
    },
    {
      "name": "savingsBalance",
      "type": "number",
      "description": "The member's current savings account balance."
    }
  ],
  "steps": [
    {
      "id": "login",
      "action": "navigate",
      "description": "Open the banking application login page.",
      "value": "http://localhost:4000",
      "checkpoint": "Login page is visible."
    },
    {
      "id": "enter-member-id",
      "action": "type",
      "description": "Enter the member ID into the member search field.",
      "target": {
        "type": "label",
        "value": "Member ID",
        "fallback": [
          {
            "type": "css",
            "value": "input[name=\"memberId\"]"
          }
        ]
      },
      "value": "{{memberId}}"
    },
    {
      "id": "search-member",
      "action": "click",
      "description": "Submit the member search.",
      "target": {
        "type": "role",
        "value": "button:Search",
        "fallback": [
          {
            "type": "text",
            "value": "Search"
          }
        ]
      },
      "checkpoint": "Member search result is displayed."
    },
    {
      "id": "read-member-name",
      "action": "extract",
      "description": "Read the member's name from the member details page.",
      "target": {
        "type": "text",
        "value": "Member Name"
      },
      "output": "memberName"
    },
    {
      "id": "read-savings-balance",
      "action": "extract",
      "description": "Read the current savings balance.",
      "target": {
        "type": "text",
        "value": "Savings Balance"
      },
      "output": "savingsBalance",
      "checkpoint": "Savings balance is available."
    }
  ],
  "successCondition": "The member details page is displayed and a savings balance has been extracted.",
  "createdAt": "2026-09-14T00:00:00.000Z",
  "status": "draft"
}